<target xml:space="preserve"><bpt id="5" rid="3">&lt;mq:rxt displaytext=&quot;&amp;lt;h2&amp;gt;&quot; val=&quot;&amp;lt;h2&amp;gt;&quot;&gt;</bpt>この機能の主な特徴<ept id="6" rid="3">&lt;/mq:rxt displaytext=&quot;&amp;lt;/h2&amp;gt;&quot; val=&quot;&amp;lt;/h2&amp;gt;&quot;&gt;</ept></target>
