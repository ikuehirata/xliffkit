<mq:commitinfos xmlns="MQXliff"><commitinfo matchrate="100" role="1000" timestamp="2026-01-10T15:23:13Z" username="user" editingtime="12754" /></mq:commitinfos><mq:nosplitjoins><mq:nosplitjoin type="JoinNext" reason="filter" /><mq:nosplitjoin type="JoinPrevious" reason="filter" /></mq:nosplitjoins>
