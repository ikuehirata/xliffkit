<trans-unit id="20" mq:minorversionend="2" mq:minorversionstart="0" mq:status="ManuallyConfirmed" mq:percent="100" mq:segmentguid="59599425-e796-4890-a770-f6c186a4b819" mq:translatorcommitmatchrate="100" mq:translatorcommitusername="user" mq:translatorcommittimestamp="2026-01-10T15:23:13Z" mq:lastchangedtimestamp="2026-01-10T15:23:13Z" mq:lastchanginguser="user" mq:maxlengthchars="-1" mq:nosplitjoin="true" mq:firstlabel="1" mq:lastlabel="1" mq:autosplitjoinstate="0" mq:lastmodifrole="0" mq:multipleexactmatch="false">
<source xml:space="preserve" mq:segpart="1"><bpt id="1" rid="1">&lt;mq:rxt displaytext=&quot;&amp;lt;p&amp;gt;&quot; val=&quot;&amp;lt;p&amp;gt;&quot;&gt;</bpt>For example, a <bpt id="2" rid="2">&lt;mq:rxt displaytext=&quot;&amp;lt;b&amp;gt;&quot; val=&quot;&amp;lt;b&amp;gt;&quot;&gt;</bpt>single English sentence<ept id="3" rid="2">&lt;/mq:rxt displaytext=&quot;&amp;lt;/b&amp;gt;&quot; val=&quot;&amp;lt;/b&amp;gt;&quot;&gt;</ept> may naturally become <bpt id="4" rid="3">&lt;mq:rxt displaytext=&quot;&amp;lt;b&amp;gt;&quot; val=&quot;&amp;lt;b&amp;gt;&quot;&gt;</bpt>two sentences<ept id="5" rid="3">&lt;/mq:rxt displaytext=&quot;&amp;lt;/b&amp;gt;&quot; val=&quot;&amp;lt;/b&amp;gt;&quot;&gt;</ept> in Japanese or German.<ept id="6" rid="1">&lt;/mq:rxt displaytext=&quot;&amp;lt;/p&amp;gt;&quot; val=&quot;&amp;lt;/p&amp;gt;&quot;&gt;</ept></source>
<target xml:space="preserve"><bpt id="1" rid="4">&lt;mq:rxt displaytext=&quot;&amp;lt;p&amp;gt;&quot; val=&quot;&amp;lt;p&amp;gt;&quot;&gt;</bpt>例えば、<bpt id="2" rid="5">&lt;mq:rxt displaytext=&quot;&amp;lt;b&amp;gt;&quot; val=&quot;&amp;lt;b&amp;gt;&quot;&gt;</bpt>1つの英文<ept id="3" rid="5">&lt;/mq:rxt displaytext=&quot;&amp;lt;/b&amp;gt;&quot; val=&quot;&amp;lt;/b&amp;gt;&quot;&gt;</ept>が日本語やドイツ語では自然に<bpt id="4" rid="6">&lt;mq:rxt displaytext=&quot;&amp;lt;b&amp;gt;&quot; val=&quot;&amp;lt;b&amp;gt;&quot;&gt;</bpt>2つの文<ept id="5" rid="6">&lt;/mq:rxt displaytext=&quot;&amp;lt;/b&amp;gt;&quot; val=&quot;&amp;lt;/b&amp;gt;&quot;&gt;</ept>になることがあります。<ept id="6" rid="4">&lt;/mq:rxt displaytext=&quot;&amp;lt;/p&amp;gt;&quot; val=&quot;&amp;lt;/p&amp;gt;&quot;&gt;</ept></target>
