<mq:originalsource edited="false" />
<mq:insertedmatch matchtype="0" source="ローカルごった煮 / user" matchrate="101" originalmatchrate="0" ambiguousexact="false" setsegmentswhensplittingintorows="false" hitfororiginalsegementversion="false"><source xml:space="preserve"><bpt id="1" rid="1">&lt;mq:rxt displaytext=&quot;&amp;lt;p&amp;gt;&quot; val=&quot;&amp;lt;p&amp;gt;&quot;&gt;</bpt>In <bpt id="2" rid="2">&lt;mq:rxt displaytext=&quot;&amp;lt;b&amp;gt;&quot; val=&quot;&amp;lt;b&amp;gt;&quot;&gt;</bpt>multilingual texts<ept id="3" rid="2">&lt;/mq:rxt displaytext=&quot;&amp;lt;/b&amp;gt;&quot; val=&quot;&amp;lt;/b&amp;gt;&quot;&gt;</ept> such as videogame store descriptions, segment splitting is often <bpt id="4" rid="3">&lt;mq:rxt displaytext=&quot;&amp;lt;b&amp;gt;&quot; val=&quot;&amp;lt;b&amp;gt;&quot;&gt;</bpt>disabled in CAT tools<ept id="5" rid="3">&lt;/mq:rxt displaytext=&quot;&amp;lt;/b&amp;gt;&quot; val=&quot;&amp;lt;/b&amp;gt;&quot;&gt;</ept> to preserve cross-language alignment.<ept id="6" rid="1">&lt;/mq:rxt displaytext=&quot;&amp;lt;/p&amp;gt;&quot; val=&quot;&amp;lt;/p&amp;gt;&quot;&gt;</ept></source>
<target xml:space="preserve"><bpt id="7" rid="4">&lt;mq:rxt displaytext=&quot;&amp;lt;p&amp;gt;&quot; val=&quot;&amp;lt;p&amp;gt;&quot;&gt;</bpt>ゲームストアでの説明文のような<bpt id="8" rid="5">&lt;mq:rxt displaytext=&quot;&amp;lt;b&amp;gt;&quot; val=&quot;&amp;lt;b&amp;gt;&quot;&gt;</bpt>多言語テキスト<ept id="9" rid="5">&lt;/mq:rxt displaytext=&quot;&amp;lt;/b&amp;gt;&quot; val=&quot;&amp;lt;/b&amp;gt;&quot;&gt;</ept>では、言語間のアライメントを維持するために、<bpt id="10" rid="6">&lt;mq:rxt displaytext=&quot;&amp;lt;b&amp;gt;&quot; val=&quot;&amp;lt;b&amp;gt;&quot;&gt;</bpt>CATツールでは<ept id="11" rid="6">&lt;/mq:rxt displaytext=&quot;&amp;lt;/b&amp;gt;&quot; val=&quot;&amp;lt;/b&amp;gt;&quot;&gt;</ept>セグメント分割が<bpt id="12" rid="7">&lt;mq:rxt displaytext=&quot;&amp;lt;b&amp;gt;&quot; val=&quot;&amp;lt;b&amp;gt;&quot;&gt;</bpt>無効化<ept id="13" rid="7">&lt;/mq:rxt displaytext=&quot;&amp;lt;/b&amp;gt;&quot; val=&quot;&amp;lt;/b&amp;gt;&quot;&gt;</ept>されることが多くあります。<ept id="14" rid="4">&lt;/mq:rxt displaytext=&quot;&amp;lt;/p&amp;gt;&quot; val=&quot;&amp;lt;/p&amp;gt;&quot;&gt;</ept></target>
</mq:insertedmatch>
</trans-unit>
